node_modules/
.env
.env.local
.DS_Store

# Local SQLite DB (backend uses a persistent disk in production)
backend/pedidos.db

# Puppeteer's downloaded Chrome binary — installed via postinstall on deploy,
# should never be committed (large binary, platform-specific).
backend/.cache/

# Build output
frontend/dist/

# iOS app — frontend/ios/ is fully regenerated by `npx cap add ios` from
# capacitor.config.json + resources/, so it doesn't need to be committed
# (same reasoning as any other generated build folder). .env.production
# holds the production API URL locally on whoever's Mac is building the
# app — not secret, just doesn't need to be tracked alongside the example.
frontend/ios/
frontend/.env.production
